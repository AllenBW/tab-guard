{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tab Guard",
  "version": "1.0.1",
  "identifier": "local.tabguard",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Utility",
    "shortDescription": "Stops runaway browser tabs from eating your Mac's memory",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "./Entitlements.plist"
    },
    "copyright": "© 2026 Allen Manzano-Wight. MIT License."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCNURCOUY5QUQwRjUyRjIKUldUeVVnK3QrYmxkNjFVZ0srTWhUdnZadHM4WExqUTU4Y0pTMjZZV3h6SnE3cURCdjZhbndwVTQK",
      "endpoints": [
        "https://github.com/AllenBW/tab-guard/releases/latest/download/latest.json"
      ]
    }
  }
}
